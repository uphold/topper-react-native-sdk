{
  "name": "@uphold/topper-react-native-sdk",
  "version": "0.1.0",
  "description": "Seamless integration of Topper on React Native applications",
  "author": "Uphold",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:uphold/topper-react-native-sdk.git"
  },
  "homepage": "https://github.com/uphold/topper-react-native-sdk#readme",
  "bugs": {
    "url": "https://github.com/uphold/topper-react-native-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "prepare": "husky install && npm run build",
    "release": "release-it"
  },
  "dependencies": {
    "query-string": "^6.3.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "react-native-webview": ">=13.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@uphold/github-changelog-generator": "^4.0.2",
    "esbuild": "^0.28.1",
    "eslint": "~9.39.2",
    "eslint-config-uphold": "^6.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-native": "^0.86.0",
    "react-native-webview": "^13.16.1",
    "release-it": "^20.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": "npm run lint"
  },
  "keywords": [
    "crypto",
    "payment",
    "ramp",
    "react-native",
    "sdk",
    "topper"
  ]
}
